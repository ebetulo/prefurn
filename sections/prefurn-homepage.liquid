.pfh3-colour{margin:12px 0;background:#fff}.pfh3-colour-inner{display:grid;grid-template-columns:.8fr 1.2fr;gap:56px;align-items:center}.pfh3-colour-copy{max-width:500px}.pfh3-colour-copy>p:not(.pfh3-kicker){margin:16px 0 20px;font-size:14px;line-height:1.7}.pfh3-link{color:#2b553e;font-size:13px;font-weight:670;text-decoration:underline;text-underline-offset:5px}.pfh3-colour-products{display:grid;grid-template-columns:1.03fr .97fr .9fr;gap:12px}.pfh3-colour-card{display:grid;grid-template-rows:245px auto;overflow:hidden;border-radius:12px;text-decoration:none;color:var(--ink)}.pfh3-colour-card img{width:100%;height:100%;object-fit:contain;padding:14px;transition:transform .25s}.pfh3-colour-red img,.pfh3-colour-blue img{mix-blend-mode:multiply}.pfh3-colour-card:hover img{transform:scale(1.035)}.pfh3-colour-card span{padding:11px 14px 13px;font-size:12px;font-weight:650}.pfh3-colour-red{background:#f1e3df}.pfh3-colour-green{background:#e3ece2}.pfh3-colour-blue{background:#e2ecf0}
.pfh3-showroom{display:grid;grid-template-columns:.72fr 1.28fr;gap:46px;align-items:center;margin-top:12px;background:var(--g);color:#fff;border-radius:14px;overflow:hidden;padding:48px}.pfh3-showroom .pfh3-kicker{color:#bfd09d!important}.pfh3-showroom-copy h2{color:#fff}.pfh3-showroom-copy>p:not(.pfh3-kicker){margin:17px 0 18px;color:#d1ddd0;font-size:14px;line-height:1.7}.pfh3-showroom-copy ul{margin:0 0 24px;padding:0;list-style:none}.pfh3-showroom-copy li{padding:8px 0;border-bottom:1px solid rgba(255,255,255,.13);color:#d5e0d4;font-size:12px}.pfh3-showroom-copy li:before{content:'✓';margin-right:8px;color:var(--lime)}.pfh3-showroom-collage{display:grid;grid-template-columns:1.2fr .8fr;grid-template-rows:1fr 1fr;gap:10px;height:480px}.pfh3-show-shot{position:relative;display:block;overflow:hidden;border-radius:10px;background:#eef0e9}.pfh3-show-shot-a{grid-row:1/3}.pfh3-show-shot img{width:100%;height:100%;object-fit:contain;padding:14px;transition:transform .25s}.pfh3-show-shot:hover img{transform:scale(1.025)}.pfh3-show-shot span{position:absolute;left:12px;bottom:12px;max-width:80%;padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.94);color:#31513e;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
