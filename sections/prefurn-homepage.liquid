  .pfh3-bf2__offer{
    display:grid;
    grid-template-columns:1fr auto;
    align-items:center;
    gap:10px 14px;
    padding:18px 20px;
  }
  .pfh3-bf2__badge{grid-column:1/-1;margin:0}
  .pfh3-bf2__proof{display:none}
  .pfh3-bf2__offer .pfh3-btn{grid-column:1/-1;margin-top:2px}
  .pfh3-bf2__from strong{font-size:29px}
}
